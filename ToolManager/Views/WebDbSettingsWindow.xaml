<Window x:Class="ToolManager.Views.WebDbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình database danh sách web" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="24,22,24,6">
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Database danh sách web" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="SQL Server chứa bảng Tên web + URL, dùng chung cho các server" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,12,24,20">
                <TextBlock Text="KẾT NỐI" Style="{StaticResource SectionLabel}" Margin="0,4,0,12"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Server"/><Run Text=" *" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox x:Name="ServerBox" FontFamily="{StaticResource MonoFont}"
                                 ToolTip="Vd: 192.168.122.10  hoặc  TEN-MAY\SQLEXPRESS  hoặc  192.168.122.10,1433"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Database"/><Run Text=" *" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox x:Name="DatabaseBox" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Đăng nhập bằng" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="WindowsAuthRadio" GroupName="Auth" Style="{StaticResource Segment}"
                                 Content="Tài khoản Windows (khuyên dùng)" Checked="Auth_Checked"/>
                    <RadioButton x:Name="SqlAuthRadio" GroupName="Auth" Style="{StaticResource Segment}"
                                 Content="Tài khoản SQL Server" Checked="Auth_Checked"/>
                </StackPanel>
                <TextBlock x:Name="AuthHint" Style="{StaticResource HintText}" Margin="0,0,0,14"/>

                <Grid x:Name="SqlLoginPanel" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tài khoản" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UserBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox"/>
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="Để trống = giữ mật khẩu đã lưu" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" x:Name="TrustCertCheck" Style="{StaticResource Switch}"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Tin cậy chứng chỉ của SQL Server (TrustServerCertificate)" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                       Text="Bật nếu gặp lỗi về certificate khi kết nối. SQL Server nội bộ thường dùng chứng chỉ tự ký."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="CÂU TRUY VẤN" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                <TextBox x:Name="QueryBox" FontFamily="{StaticResource MonoFont}" FontSize="12" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top"/>
                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                           Text="Phải trả về 2 cột tên Name và Url. Bảng đặt tên khác thì dùng AS, vd: SELECT TenWeb AS Name, DuongDan AS Url FROM ..."/>
                <Button HorizontalAlignment="Left" Style="{StaticResource SmallButton}" Margin="0,8,0,0" Click="CopyScript_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Copy script tạo bảng dbo.WebRegistry"/>
                    </StackPanel>
                </Button>

                <!-- Kết quả kiểm tra kết nối -->
                <Border x:Name="StatusBorder" Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxWidth="520" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Hủy" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="100" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Lưu"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TestButton" Click="Test_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE703;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Kiểm tra kết nối"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton" Click="Clear_Click" Foreground="{StaticResource DangerTextBrush}" Visibility="Collapsed">
                        <TextBlock Text="Xóa cấu hình"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
