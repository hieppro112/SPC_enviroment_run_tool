<Window x:Class="ToolManager.Views.DeployRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ToolManager.Services"
        Title="Tạo deploy từ repo" Width="760" Height="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Badge trạng thái yêu cầu -->
        <DataTemplate x:Key="RequestPill">
            <Border x:Name="Pill" CornerRadius="11" Padding="9,3,11,3" Background="{StaticResource NeutralSoftBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource TextSubtleBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="Txt" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralTextBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DeployRequestStatus.Pending}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DeployRequestStatus.Running}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DeployRequestStatus.Done}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DeployRequestStatus.Failed}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="24,22,24,6">
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8F4;" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Tạo deploy từ repo" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Gửi yêu cầu để Claude Code trên máy này tạo deploy.cmd / rollback.cmd cho folder" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Form tạo yêu cầu -->
        <StackPanel Grid.Row="1" Margin="24,12,24,0">
            <TextBlock Text="FOLDER CẦN TẠO DEPLOY" Style="{StaticResource SectionLabel}" Margin="0,4,0,12"/>

            <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="Folder đã git clone / pull về máy này"/><Run Text=" *" Foreground="{StaticResource DangerBrush}"/>
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" FontFamily="{StaticResource MonoFont}" TextChanged="FolderBox_TextChanged"/>
                <Button Grid.Column="1" Click="BrowseFolder_Click" Margin="6,0,0,0" Padding="10,7" ToolTip="Chọn folder">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="13"/>
                </Button>
            </Grid>
            <TextBlock x:Name="FolderInfo" Style="{StaticResource HintText}" Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="Chọn folder gốc của repo (folder có thư mục .git)."/>

            <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="Tên tool trong Tool Manager"/><Run Text=" *" Foreground="{StaticResource DangerBrush}"/>
            </TextBlock>
            <TextBox x:Name="ToolNameBox" Margin="0,0,0,14"/>

            <TextBlock Text="Ghi chú cho Claude (không bắt buộc)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="58" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Vd: chạy ở port 5060; project nằm trong thư mục con api\; chỉ build bản web. Không ghi mật khẩu hay key vào đây."/>

            <!-- Kết quả gửi / lỗi kết nối -->
            <Border x:Name="StatusBorder" Margin="0,14,0,0" CornerRadius="8" Padding="12,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxWidth="660" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Danh sách yêu cầu gần đây -->
        <DockPanel Grid.Row="2" Margin="24,20,24,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Tải lại"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ListTitle" Text="YÊU CẦU GẦN ĐÂY TRÊN MÁY NÀY" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource Card}" CornerRadius="8" Padding="12,10,8,4">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RequestList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,4,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE838;" Margin="0,0,4,0"
                                                    ToolTip="Mở folder" Tag="{Binding}" Click="OpenFolder_Click"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;"
                                                    ToolTip="Hủy yêu cầu đang chờ" Tag="{Binding}" Click="Cancel_Click"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource RequestPill}"
                                                        Focusable="False" Width="104" Margin="0,1,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FolderPath}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
                                            <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding ErrorLog}" FontSize="11" Foreground="{StaticResource DangerTextBrush}"
                                                       TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ListEmpty" Text="Chưa có yêu cầu nào trên máy này." FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Đóng" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
                    <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="130" Click="Send_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE724;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Gửi yêu cầu"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button HorizontalAlignment="Left" Style="{StaticResource SmallButton}" Click="CopyScript_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Copy script tạo bảng dbo.ToolManagerDeployRequest"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
