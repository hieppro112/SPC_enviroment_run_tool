<Window x:Class="ToolManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ToolManager.Views"
        Title="Tool Manager" Height="840" Width="1320" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        Icon="/icons8-module-94.ico"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="KVH - IT" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Quản lý và giám sát các tool chạy nền" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Tab chuyển màn hình -->
                <Rectangle DockPanel.Dock="Left" Width="1" Height="28" Fill="{StaticResource LineBrush}" Margin="24,0,16,0"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ToolsTab" Style="{StaticResource NavTab}" IsChecked="True" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71D;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Tools"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PortsTab" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE968;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Ports"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button DockPanel.Dock="Right" Click="OpenLogRoot_Click" ToolTip="Mở thư mục chứa toàn bộ file log">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Thư mục log"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OpenConfig_Click" Margin="0,0,8,0" ToolTip="Mở file cấu hình tools.json">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="tools.json"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ===================== Trang Ports ===================== -->
        <views:PortsView Grid.Row="1" x:Name="PortsPage" Margin="24,20,24,0" Visibility="Collapsed"/>

        <!-- ===================== Trang Tools ===================== -->
        <Grid Grid.Row="1" x:Name="ToolsPage" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="200"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="2*" MinHeight="160"/>
            </Grid.RowDefinitions>

            <!-- Thẻ thống kê -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71D;" FontSize="17"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG SỐ TOOL" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="StatTotal" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="16"
                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐANG CHẠY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="StatRunning" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{StaticResource SuccessTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="10" Background="{StaticResource WarningSoftBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE823;" FontSize="17"
                                       Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CHỜ CHẠY LẠI" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="StatWaiting" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{StaticResource WarningTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="10" Background="{StaticResource DangerSoftBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="17"
                                       Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CÓ LỖI / ĐÃ THOÁT" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="StatCrashed" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{StaticResource DangerTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Danh sách tool -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="18,14" LastChildFill="False">
                        <DockPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DockPanel.Resources>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Danh sách tool" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Double-click vào một dòng để sửa cấu hình" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm tool"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="StopAll_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0"
                                           Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="Stop tất cả"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="StartAll_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Start tất cả"/>
                            </StackPanel>
                        </Button>

                        <!-- Ô tìm kiếm -->
                        <Grid DockPanel.Dock="Right" Width="240" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Padding="32,7,8,7" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False"/>
                            <TextBlock Text="Tìm theo tên tool..." Margin="34,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="ToolGrid" Style="{StaticResource ToolDataGrid}"
                              ItemsSource="{Binding Runners}" Margin="0,0,0,8"
                              SelectionChanged="ToolGrid_SelectionChanged"
                              MouseDoubleClick="ToolGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="TOOL" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Config.Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,1"
                                                        Visibility="{Binding Config.PortsText, Converter={StaticResource EmptyToCollapsed}}">
                                                    <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource NeutralTextBrush}"
                                                               Text="{Binding Config.PortsText, StringFormat='port {0}'}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Config.ExePath}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Config.ExePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" Focusable="False"/>
                                            <Button Style="{StaticResource ErrorBadgeButton}" Content="{Binding ErrorBadgeText}"
                                                    ToolTip="{Binding ErrorTooltip}" Click="ErrorBadge_Click"
                                                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="PID" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Pid, TargetNullValue='—'}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THỜI GIAN CHẠY" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Uptime}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TỰ CHẠY LẠI" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RestartCount, StringFormat='{}{0} lần'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="LẦN THOÁT GẦN NHẤT" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastExit}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="236">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Start"
                                                    Foreground="{StaticResource SuccessBrush}"
                                                    Click="Start_Click" IsEnabled="{Binding CanStart}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Click="Stop_Click" IsEnabled="{Binding CanStop}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Restart"
                                                    Foreground="{StaticResource AccentBrush}" Click="Restart_Click"/>
                                            <Rectangle Width="1" Height="18" Fill="{StaticResource LineBrush}" Margin="6,0"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Sửa cấu hình"
                                                    Click="Edit_Click"/>
                                            <Button Style="{StaticResource IconDangerButton}" Content="&#xE74D;" ToolTip="Xóa khỏi danh sách"
                                                    Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Trạng thái trống -->
                    <StackPanel Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource NeutralSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71D;" FontSize="22"
                                       Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="Chưa có tool nào" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Bấm “Thêm tool” để khai báo file exe cần quản lý."/>
                        <Button x:Name="EmptyAddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click"
                                HorizontalAlignment="Center" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm tool đầu tiên"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="2" Style="{StaticResource RowSplitter}"/>

            <!-- Log -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Background="{StaticResource LogBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10,10,0,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE756;" FontSize="15"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="Log" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedItem.Config.Name, ElementName=ToolGrid}"
                                       FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="10,0,12,0"/>
                            <ContentControl DockPanel.Dock="Left" Focusable="False"
                                            Content="{Binding SelectedItem, ElementName=ToolGrid}"
                                            ContentTemplate="{StaticResource StatusPill}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ToolGrid}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Button DockPanel.Dock="Left" Style="{StaticResource ErrorBadgeButton}"
                                    DataContext="{Binding SelectedItem, ElementName=ToolGrid}"
                                    Content="{Binding ErrorBadgeText}" ToolTip="{Binding ErrorTooltip}" Click="ErrorBadge_Click"
                                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="OpenToolLog_Click"
                                    ToolTip="Mở file log hôm nay của tool">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Mở file log"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="ClearLog_Click" Margin="0,0,6,0"
                                    ToolTip="Xóa log trên màn hình (file log vẫn giữ nguyên)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Xóa màn hình"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="CopyLog_Click" Margin="0,0,6,0"
                                    ToolTip="Copy các dòng đang chọn (hoặc toàn bộ nếu không chọn)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Copy"/>
                                </StackPanel>
                            </Button>
                            <CheckBox DockPanel.Dock="Right" x:Name="AutoScrollCheck" Style="{StaticResource Switch}"
                                      IsChecked="True" Margin="0,0,16,0" FontSize="12.5">
                                <TextBlock Text="Tự cuộn" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </CheckBox>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LogList"
                             ItemsSource="{Binding SelectedItem.Logs, ElementName=ToolGrid}"
                             Background="Transparent" BorderThickness="0" Padding="8,6"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="8,1.5">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource LogIsError}}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrongBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Converter={StaticResource LogPart}, ConverterParameter=time}"
                                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Converter={StaticResource LogPart}, ConverterParameter=text}"
                                               Foreground="{Binding Converter={StaticResource LogBrush}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyLog_Executed"/>
                        </ListBox.CommandBindings>
                    </ListBox>

                    <!-- Chưa chọn tool -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=ToolGrid}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE756;" FontSize="26"
                                   Foreground="{StaticResource LineStrongBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một tool trong danh sách để xem log" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Footer ===================== -->
        <DockPanel Grid.Row="2" Margin="26,10,26,12">
            <TextBlock DockPanel.Dock="Right" x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSubtleBrush}"/>
            <TextBlock x:Name="ConfigPathText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
